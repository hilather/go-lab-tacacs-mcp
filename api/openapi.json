    "/api/v1/events/stream": {
      "get": {
        "description": "Clears the HTTP write deadline and emits comment keep-alives. Last-Event-ID resumes from the ring. Scopes: events:read.",
        "operationId": "events.subscribe",
        "parameters": [
          {
            "in": "header",
            "name": "Last-Event-ID",
            "schema": {
              "type": "string"
            }
          },
          {
            "explode": true,
            "in": "query",
            "name": "category",
            "schema": {
